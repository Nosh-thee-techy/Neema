# Local secrets — never commit. Copied from CareLoop pattern.
MSINGI_API_KEY=
MSINGI_BASE_URL=https://api.msingiai.com
# Female 2. The catalog name "female" is pitched like a man, so Neema does not use it.
MSINGI_VOICE=female2
# OpenRouter (CareLoop LLM key) — allowlisted How2Sign clip planning only
OPENROUTER_API_KEY=
CARELOOP_LLM_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
VITE_ENABLE_ASL_DEMO=true
# SOS voice call + SMS. Use Africa's Talking for Kenyan numbers, or Twilio.
# The call speaks the alert. 999 is never dialled from the server.
# Africa's Talking voice callback URL: https://neema-web.fly.dev/api/calls/voice
AT_API_KEY=
AT_USERNAME=
AT_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Sensor database. Neema logs in on the server and keeps the session cookie.
# READINGS_API_USERNAME=
# READINGS_API_PASSWORD=
# READINGS_API_URL=https://bp-sensor.57-131-131-200.sslip.io/api/readings?device=esp32-3076f5f070a8&limit=1
